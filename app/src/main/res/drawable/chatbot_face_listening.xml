        android:pathData="M125,82 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
        android:fillColor="#00BCD4" />
    <!-- Đồng tử phải -->
    <path
        android:pathData="M125,82 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#1A2634" />
    <!-- Ánh sáng mắt phải -->
    <path
        android:pathData="M120,77 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#FFFFFF" />

    <!-- Miệng hé mở (đang lắng nghe) -->
    <path
        android:pathData="M80,120 Q100,130 120,120"
        android:fillColor="#00000000"
        android:strokeColor="#4CAF50"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Sóng âm thanh bên trái tai -->
    <path
        android:pathData="M20,90 Q15,100 20,110"
        android:fillColor="#00000000"
        android:strokeColor="#4CAF50"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillAlpha="0.7" />
