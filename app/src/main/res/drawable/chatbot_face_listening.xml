    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Nền hình tròn -->
    <path
        android:pathData="M100,100 m-90,0 a90,90 0 1,0 180,0 a90,90 0 1,0 -180,0"
        android:fillColor="#1A2634" />

    <!-- Viền ngoài (màu xanh lá - đang active) -->
    <path
        android:pathData="M100,100 m-90,0 a90,90 0 1,0 180,0 a90,90 0 1,0 -180,0"
        android:fillColor="#00000000"
        android:strokeColor="#4CAF50"
        android:strokeWidth="4" />

    <!-- Mắt trái (tròn to) -->
    <path
        android:pathData="M75,82 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
        android:fillColor="#00BCD4" />
    <!-- Đồng tử trái -->
    <path
        android:pathData="M75,82 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#1A2634" />
    <!-- Ánh sáng mắt trái -->
    <path
        android:pathData="M70,77 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#FFFFFF" />

    <!-- Mắt phải (tròn to) -->
